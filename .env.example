# URL koneksi Database PostgreSQL Anda
# Gunakan format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/hris_db"

# Kunci rahasia untuk otentikasi sesi (NextAuth)
# Generate menggunakan perintah: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_base64_here"

# URL base aplikasi Anda (penting untuk NextAuth di mode produksi)
NEXTAUTH_URL="http://localhost:3000"

# Kunci rahasia untuk enkripsi data sensitif (seperti nominal gaji dan no rekening)
# HARUS tepat 32 karakter (misalnya bisa dihasilkan acak)
ENCRYPTION_SECRET="12345678901234567890123456789012"
